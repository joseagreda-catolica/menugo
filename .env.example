# PostgreSQL (usado por docker-compose y por api/.env)
POSTGRES_USER=menugo
POSTGRES_PASSWORD=menugo
POSTGRES_DB=menugo
POSTGRES_PORT=5432

# Cadena de conexion que usa Prisma (api/.env)
DATABASE_URL="postgresql://menugo:menugo@localhost:5432/menugo?schema=public"

# API
PORT=3000
JWT_SECRET=cambia-este-valor-en-cada-maquina
JWT_EXPIRES_IN=8h

# Contrasena de los usuarios de prueba que crea `npm run seed` (por defecto menugo123).
# En un despliegue publico, definir una propia. Ver docs/despliegue.md.
SEED_PASSWORD=

# Cloudinary (B0-10, llenar con las credenciales reales, nunca commitear)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
